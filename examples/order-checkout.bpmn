<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" targetNamespace="https://github.com/majorgilles/visualize-flow">
<bpmn:collaboration id="collaboration">
<bpmn:participant id="pool" name="shop: order checkout" processRef="process"/>
<bpmn:participant id="ext_stripe" name="Stripe"/>
<bpmn:messageFlow id="message_1_out" sourceRef="charge" targetRef="ext_stripe"/>
<bpmn:messageFlow id="message_1_in" sourceRef="ext_stripe" targetRef="charge"/>
</bpmn:collaboration>
<bpmn:process id="process" isExecutable="false">
<bpmn:laneSet id="lane_set"><bpmn:lane id="lane_api" name="API"><bpmn:flowNodeRef>start</bpmn:flowNodeRef><bpmn:flowNodeRef>save</bpmn:flowNodeRef><bpmn:flowNodeRef>publish</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="lane_worker" name="Payment worker"><bpmn:flowNodeRef>charge</bpmn:flowNodeRef><bpmn:flowNodeRef>paid</bpmn:flowNodeRef><bpmn:flowNodeRef>ship</bpmn:flowNodeRef><bpmn:flowNodeRef>done</bpmn:flowNodeRef><bpmn:flowNodeRef>declined</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
<bpmn:startEvent id="start" name="Order placed"><bpmn:messageEventDefinition/></bpmn:startEvent>
<bpmn:serviceTask id="save" name="Save order (PENDING)"></bpmn:serviceTask>
<bpmn:intermediateThrowEvent id="publish" name="ORDER_PLACED"><bpmn:messageEventDefinition/></bpmn:intermediateThrowEvent>
<bpmn:serviceTask id="charge" name="Charge card"></bpmn:serviceTask>
<bpmn:exclusiveGateway id="paid" name="Paid?"></bpmn:exclusiveGateway>
<bpmn:sendTask id="ship" name="Request shipment"></bpmn:sendTask>
<bpmn:endEvent id="done" name="Shipped"></bpmn:endEvent>
<bpmn:endEvent id="declined" name="PAYMENT_DECLINED"><bpmn:messageEventDefinition/></bpmn:endEvent>
<bpmn:sequenceFlow id="flow_1" sourceRef="start" targetRef="save"/>
<bpmn:sequenceFlow id="flow_2" sourceRef="save" targetRef="publish"/>
<bpmn:sequenceFlow id="flow_3" sourceRef="publish" targetRef="charge"/>
<bpmn:sequenceFlow id="flow_4" sourceRef="charge" targetRef="paid"/>
<bpmn:sequenceFlow id="flow_5" sourceRef="paid" targetRef="ship" name="Yes"/>
<bpmn:sequenceFlow id="flow_6" sourceRef="paid" targetRef="declined" name="No"/>
<bpmn:sequenceFlow id="flow_7" sourceRef="ship" targetRef="done"/>
<bpmn:textAnnotation id="annotation_1"><bpmn:text>No idempotency key: a retry may charge twice.</bpmn:text></bpmn:textAnnotation><bpmn:association id="annotation_1_link" sourceRef="charge" targetRef="annotation_1"/>
</bpmn:process>
<bpmndi:BPMNDiagram id="diagram"><bpmndi:BPMNPlane id="plane" bpmnElement="collaboration">
<bpmndi:BPMNShape id="pool_di" bpmnElement="pool" isHorizontal="true"><dc:Bounds x="40" y="150" width="1148" height="450"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="lane_api_di" bpmnElement="lane_api" isHorizontal="true"><dc:Bounds x="70" y="150" width="1118" height="160"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="lane_worker_di" bpmnElement="lane_worker" isHorizontal="true"><dc:Bounds x="70" y="310" width="1118" height="290"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="ext_stripe_di" bpmnElement="ext_stripe" isHorizontal="true"><dc:Bounds x="575" y="30" width="150" height="60"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="start_di" bpmnElement="start"><dc:Bounds x="152" y="212" width="36" height="36"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="save_di" bpmnElement="save"><dc:Bounds x="280" y="190" width="100" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="publish_di" bpmnElement="publish"><dc:Bounds x="472" y="212" width="36" height="36"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="charge_di" bpmnElement="charge"><dc:Bounds x="600" y="350" width="100" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="paid_di" bpmnElement="paid" isMarkerVisible="true"><dc:Bounds x="785" y="365" width="50" height="50"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="ship_di" bpmnElement="ship"><dc:Bounds x="920" y="350" width="100" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="done_di" bpmnElement="done"><dc:Bounds x="1112" y="372" width="36" height="36"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="declined_di" bpmnElement="declined"><dc:Bounds x="792" y="502" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="834" y="506" width="100" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="annotation_1_di" bpmnElement="annotation_1"><dc:Bounds x="580" y="488" width="140" height="64"/></bpmndi:BPMNShape>
<bpmndi:BPMNEdge id="flow_1_di" bpmnElement="flow_1"><di:waypoint x="188" y="230"/><di:waypoint x="280" y="230"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="flow_2_di" bpmnElement="flow_2"><di:waypoint x="380" y="230"/><di:waypoint x="472" y="230"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="flow_3_di" bpmnElement="flow_3"><di:waypoint x="508" y="230"/><di:waypoint x="554" y="230"/><di:waypoint x="554" y="390"/><di:waypoint x="600" y="390"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="flow_4_di" bpmnElement="flow_4"><di:waypoint x="700" y="390"/><di:waypoint x="785" y="390"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="flow_5_di" bpmnElement="flow_5"><di:waypoint x="835" y="390"/><di:waypoint x="920" y="390"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="flow_6_di" bpmnElement="flow_6"><di:waypoint x="810" y="415"/><di:waypoint x="810" y="502"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="flow_7_di" bpmnElement="flow_7"><di:waypoint x="1020" y="390"/><di:waypoint x="1112" y="390"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="message_1_out_di" bpmnElement="message_1_out"><di:waypoint x="635" y="350"/><di:waypoint x="635" y="90"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="message_1_in_di" bpmnElement="message_1_in"><di:waypoint x="665" y="90"/><di:waypoint x="665" y="350"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="annotation_1_link_di" bpmnElement="annotation_1_link"><di:waypoint x="650" y="430"/><di:waypoint x="650" y="488"/></bpmndi:BPMNEdge>
</bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
